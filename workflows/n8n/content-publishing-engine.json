    {
      "parameters": {
        "jsCode": "// 1. Get current time specifically in your timezone\nconst now = new Date(new Date().toLocaleString(\"en-US\", {timeZone: \"Africa/Lagos\"}));\n\n// 2. Format today's date as YYYY-MM-DD to match your sheet\nconst todayStr = now.getFullYear() + \"-\" + String(now.getMonth() + 1).padStart(2, '0') + \"-\" + String(now.getDate()).padStart(2, '0');\n\nreturn items.filter(item => {\n  const postDate = item.json['Date'];\n  const timeStr = item.json['Peak Viral Time']; // e.g. \"12:15 PM\"\n\n  // Ignore if it's not scheduled for today\n  if (postDate !== todayStr) return false;\n\n  // 3. Convert sheet time (12:15 PM) to a real machine timestamp\n  const [time, modifier] = timeStr.split(' ');\n  let [hours, minutes] = time.split(':');\n  hours = parseInt(hours, 10);\n  if (hours === 12 && modifier === 'AM') hours = 0;\n  if (hours < 12 && modifier === 'PM') hours += 12;\n\n  const scheduledTime = new Date(now.getFullYear(), now.getMonth(), now.getDate(), hours, parseInt(minutes, 10));\n\n  // 4. The Golden Rule: If current time is greater than or equal to scheduled time, POST IT.\n  return now >= scheduledTime;\n});"
      },
